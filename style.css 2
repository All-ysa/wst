* {
        box-sizing:border-box;
        margin:0;
        padding:0;
}
:root {
        --bg:#080908;
        --card:#111310;
        --soft:#171a16;
        --text:#f4f2e9;
        --muted:#a5a69d;
        --gold:#d8a62c;
        --line:rgba(255,255,255,.11);
        --serif:"Playfair Display",serif;
        --sans:"DM Sans",sans-serif;
}
html {
        scroll-behavior:smooth;
}
body {
        font-family:var(--sans);
        background:var(--bg);
        color:var(--text);
        line-height:1.5;
}
a {
        color:inherit;
        text-decoration:none;
}
button,input {
        font:inherit;
}
.site-nav {
        position:fixed;
        z-index:50;
        top:20px;
        left:50%;
        transform:translateX(-50%);
        width:min(1080px,calc(100% - 40px));
        height:64px;
        padding:8px 10px 8px 18px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        border:1px solid var(--line);
        background:rgba(10,11,9,.76);
        backdrop-filter:blur(18px);
        border-radius:40px;
}
.brand {
        display:flex;
        align-items:center;
        gap:10px;
        min-width:max-content;
}
.brand-mark {
        display:grid;
        place-items:center;
        width:34px;
        height:34px;
        border:1px solid rgba(216,166,44,.55);
        border-radius:50%;
        color:var(--gold);
        font-size:15px;
}
.brand b {
        display:block;
        font-size:11px;
        letter-spacing:2px;
        line-height:1;
}
.brand small {
        display:block;
        color:#888b82;
        font-size:8px;
        letter-spacing:3px;
        margin-top:4px;
}
nav {
        display:flex;
        gap:28px;
        margin-left:auto;
        margin-right:25px;
}
nav a {
        font-size:13px;
        color:#aeb0a8;
        transition:.25s;
}
nav a:hover,nav a.active {
        color:#fff;
}
.nav-cta {
        background:var(--gold);
        color:#111;
        padding:10px 16px;
        border-radius:24px;
        font-size:12px;
        font-weight:700;
}
.nav-cta span {
        margin-left:8px;
}
.menu-btn {
        display:none;
        background:none;
        border:0;
        color:white;
        font-size:22px;
}
.hero {
        min-height:100vh;
        position:relative;
        display:flex;
        align-items:center;
        overflow:hidden;
        background:linear-gradient(90deg,rgba(5,8,5,.9),rgba(5,8,5,.35)),url("https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=2200&q=85") center/cover;
}
.hero:after {
        content:"";
        position:absolute;
        inset:0;
        background:linear-gradient(0deg,var(--bg),transparent 25%,rgba(0,0,0,.1) 70%,rgba(0,0,0,.4));
}
.hero-content {
        position:relative;
        z-index:2;
        width:min(1050px,90%);
        margin:70px auto 0;
}
.eyebrow {
        font-size:10px;
        letter-spacing:3px;
        color:#c5c7be;
        font-weight:700;
        margin-bottom:18px;
}
.eyebrow.gold {
        color:var(--gold);
}
.hero h1 {
        font-family:var(--serif);
        font-size:clamp(48px,7vw,88px);
        font-weight:500;
        line-height:.98;
        letter-spacing:-3px;
        max-width:800px;
}
.hero h1 em,.section h2 em,.page-hero h1 em {
        color:var(--gold);
        font-style:normal;
}
.hero-copy {
        max-width:570px;
        color:#c4c5be;
        font-size:15px;
        margin:28px 0;
}
.hero-actions {
        display:flex;
        align-items:center;
        gap:25px;
}
.btn {
        display:inline-flex;
        align-items:center;
        gap:28px;
        padding:14px 19px;
        border-radius:30px;
        font-size:12px;
        font-weight:700;
}
.btn-primary {
        background:var(--gold);
        color:#111;
}
.btn-outline {
        border:1px solid var(--line);
}
.btn span {
        font-size:18px;
}
.text-link {
        font-size:12px;
        color:#d4d5cf;
        border-bottom:1px solid #777;
        padding-bottom:5px;
}
.hero-scroll {
        position:absolute;
        z-index:3;
        right:5%;
        bottom:110px;
        writing-mode:vertical-rl;
        font-size:9px;
        letter-spacing:3px;
        color:#a4a69d;
}
.hero-scroll span {
        display:block;
        width:1px;
        height:45px;
        background:#777;
        margin:12px auto 0;
}
.hero-stats {
        position:absolute;
        z-index:3;
        bottom:38px;
        left:50%;
        transform:translateX(-50%);
        width:min(1050px,90%);
        display:flex;
        gap:60px;
}
.hero-stats div {
        display:flex;
        gap:10px;
        align-items:baseline;
}
.hero-stats strong {
        font-family:var(--serif);
        font-size:25px;
}
.hero-stats span {
        font-size:8px;
        letter-spacing:2px;
        color:#999b92;
}
.section {
        width:min(1100px,90%);
        margin:auto;
        padding:115px 0;
}
.intro {
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:80px;
        align-items:end;
}
.section h2 {
        font-family:var(--serif);
        font-size:clamp(38px,5vw,60px);
        line-height:1.05;
        font-weight:500;
        letter-spacing:-1.5px;
}
.intro-copy {
        color:#a8aaa1;
        max-width:470px;
        font-size:15px;
        line-height:1.9;
}
.section-heading {
        display:flex;
        justify-content:space-between;
        align-items:end;
        margin-bottom:45px;
}
.section-heading>p {
        color:#8f918a;
        font-size:13px;
        max-width:320px;
}
.section-heading.compact {
        align-items:center;
}
.category-grid {
        display:grid;
        grid-template-columns:repeat(5,1fr);
        gap:12px;
}
.category-card {
        position:relative;
        min-height:360px;
        border-radius:4px;
        overflow:hidden;
        background-size:cover;
        background-position:center;
        display:flex;
        align-items:end;
        padding:23px;
        transition:.4s;
}
.category-card:before {
        content:"";
        position:absolute;
        inset:0;
        background:linear-gradient(0deg,rgba(0,0,0,.85),transparent 70%);
}
.category-card:hover {
        transform:translateY(-8px);
}
.category-card .cat-content {
        position:relative;
        z-index:2;
}
.category-card .number {
        font-size:10px;
        color:#c8c8c0;
        letter-spacing:2px;
}
.category-card h3 {
        font-family:var(--serif);
        font-size:27px;
        line-height:1.05;
        margin-top:6px;
}
.category-card p {
        font-size:10px;
        color:#b3b4ad;
        margin-top:9px;
}
.destination-grid {
        display:grid;
        grid-template-columns:repeat(3,1fr);
        gap:18px;
}
.destination-card {
        display:block;
        background:var(--card);
        border:1px solid var(--line);
        overflow:hidden;
        border-radius:5px;
        transition:.35s;
}
.destination-card:hover {
        transform:translateY(-6px);
        border-color:rgba(216,166,44,.35);
}
.destination-image {
        height:245px;
        background-size:cover;
        background-position:center;
        position:relative;
}
.destination-image .tag {
        position:absolute;
        top:14px;
        left:14px;
        padding:6px 9px;
        background:rgba(8,9,8,.75);
        backdrop-filter:blur(8px);
        font-size:8px;
        letter-spacing:1.5px;
}
.destination-info {
        padding:19px;
}
.destination-info h3 {
        font-family:var(--serif);
        font-size:24px;
        font-weight:500;
}
.destination-info p {
        font-size:11px;
        color:#8f918b;
        margin-top:5px;
}
.destination-info .arrow {
        float:right;
        color:var(--gold);
        font-size:20px;
        margin-top:-22px;
}
.quote-section {
        padding:150px 20px;
        background:linear-gradient(rgba(8,9,8,.84),rgba(8,9,8,.92)),url("https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2200&q=85") center/cover;
        background-attachment:fixed;
}
.quote-inner {
        max-width:850px;
        margin:auto;
        text-align:center;
}
.quote-mark {
        font-family:var(--serif);
        font-size:70px;
        color:var(--gold);
        line-height:.5;
}
.quote-inner blockquote {
        font-family:var(--serif);
        font-size:clamp(30px,5vw,54px);
        line-height:1.15;
        margin:30px 0;
        font-weight:500;
}
.quote-inner p {
        font-size:9px;
        letter-spacing:3px;
        color:#888;
}
.about {
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:80px;
        align-items:center;
}
.about-image {
        height:500px;
        background:linear-gradient(0deg,rgba(0,0,0,.2),rgba(0,0,0,.1)),url("https://images.unsplash.com/photo-1544550285-f813152fb2fd?auto=format&fit=crop&w=1200&q=85") center/cover;
}
.about-copy p:not(.eyebrow) {
        color:#999b94;
        line-height:1.9;
        margin:25px 0;
        max-width:480px;
}
.footer {
        border-top:1px solid var(--line);
        padding:35px max(5%,calc((100% - 1100px)/2));
        display:flex;
        align-items:center;
        justify-content:space-between;
        color:#777970;
        font-size:11px;
}
.footer .brand {
        color:#fff;
}
.footer p {
        margin-left:auto;
        margin-right:30px;
}
.page-hero {
        min-height:55vh;
        display:flex;
        align-items:end;
        padding:150px 5% 70px;
        background:linear-gradient(0deg,var(--bg),rgba(8,9,8,.15)),url("https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=2200&q=85") center/cover;
}
.page-hero-content {
        width:min(1100px,100%);
        margin:auto;
}
.page-hero h1 {
        font-family:var(--serif);
        font-size:clamp(46px,6vw,75px);
        line-height:1.03;
        font-weight:500;
}
.page-hero p:last-child {
        color:#aaa;
        margin-top:15px;
}
.explore-section {
        padding-top:55px;
}
.filter-bar {
        display:flex;
        gap:9px;
        flex-wrap:wrap;
        margin-bottom:35px;
}
.filter-btn {
        border:1px solid var(--line);
        background:transparent;
        color:#aaa;
        padding:10px 15px;
        border-radius:25px;
        font-size:10px;
        cursor:pointer;
}
.filter-btn.active,.filter-btn:hover {
        background:var(--gold);
        color:#111;
        border-color:var(--gold);
}
.results-head {
        display:flex;
        justify-content:space-between;
        align-items:center;
        margin-bottom:22px;
}
.results-head>span {
        font-size:10px;
        color:#85877f;
        letter-spacing:1px;
}
.search-box {
        border:1px solid var(--line);
        border-radius:25px;
        padding:9px 15px;
        display:flex;
        gap:8px;
        align-items:center;
        width:260px;
}
.search-box span {
        color:var(--gold);
}
.search-box input {
        background:none;
        border:0;
        outline:0;
        color:white;
        width:100%;
        font-size:11px;
}
.search-box input::placeholder {
        color:#6f716a;
}
.destination-grid.large {
        grid-template-columns:repeat(3,1fr);
}
.detail-hero {
        min-height:82vh;
        position:relative;
        display:flex;
        align-items:end;
        padding:120px 5% 75px;
        background-size:cover;
        background-position:center;
}
.detail-hero:after {
        content:"";
        position:absolute;
        inset:0;
        background:linear-gradient(0deg,rgba(8,9,8,1),transparent 70%);
}
.detail-content {
        position:relative;
        z-index:2;
        width:min(1100px,100%);
        margin:auto;
}
.back-link {
        font-size:11px;
        color:#aaa;
        margin-bottom:35px;
        display:inline-block;
}
.detail-category {
        font-size:10px;
        letter-spacing:3px;
        color:var(--gold);
        font-weight:700;
}
.detail-title {
        font-family:var(--serif);
        font-size:clamp(55px,8vw,100px);
        line-height:.95;
        font-weight:500;
        max-width:850px;
        margin-top:12px;
}
.detail-location {
        font-size:14px;
        color:#c0c1bb;
        margin-top:20px;
}
.detail-body {
        display:grid;
        grid-template-columns:1.3fr .7fr;
        gap:90px;
        padding-top:0;
}
.detail-body h2 {
        font-family:var(--serif);
        font-size:36px;
        font-weight:500;
        margin-bottom:18px;
}
.detail-body p {
        color:#9b9d95;
        line-height:1.9;
        font-size:14px;
}
.detail-facts {
        border-left:1px solid var(--line);
        padding-left:35px;
}
.fact {
        padding:18px 0;
        border-bottom:1px solid var(--line);
}
.fact span {
        display:block;
        color:#73756e;
        font-size:9px;
        letter-spacing:2px;
        margin-bottom:5px;
}
.fact strong {
        font-size:14px;
        font-weight:500;
}
.nearby {
        padding-top:30px;
}
@media(max-width:850px) {
        nav{display:none;
}
.site-nav {
        width:calc(100% - 24px);
        top:12px;
}
.nav-cta {
        display:none;
}
.menu-btn {
        display:block;
}
.site-nav.open nav {
        display:flex;
        position:absolute;
        top:70px;
        left:0;
        right:0;
        margin:0;
        padding:18px 22px;
        flex-direction:column;
        gap:18px;
        background:rgba(10,11,9,.96);
        border:1px solid var(--line);
        border-radius:20px;
}
.hero-content {
        margin-top:40px;
}
.hero h1 {
        letter-spacing:-2px;
}
.hero-scroll {
        display:none;
}
.hero-stats {
        gap:18px;
}
.hero-stats div {
        display:block;
}
.hero-stats strong {
        display:block;
}
.hero-stats span {
        font-size:7px;
}
.intro,.about {
        grid-template-columns:1fr;
        gap:35px;
}
.category-grid {
        grid-template-columns:repeat(2,1fr);
}
.category-card {
        min-height:280px;
}
.category-card:last-child {
        grid-column:span 2;
}
.destination-grid,.destination-grid.large {
        grid-template-columns:repeat(2,1fr);
}
.section {
        padding:80px 0;
}
.section-heading {
        display:block;
}
.section-heading>p {
        margin-top:18px;
}
.footer {
        flex-wrap:wrap;
        gap:20px;
}
.footer p {
        margin-left:0;
        margin-right:0;
}
.detail-body {
        grid-template-columns:1fr;
        gap:45px;
}
.detail-facts {
        border-left:0;
        border-top:1px solid var(--line);
        padding:20px 0;
}
.detail-hero {
        min-height:75vh;
}
}
@media(max-width:560px) {
        .hero{min-height:760px;
}
.hero-content {
        width:86%;
}
.hero h1 {
        font-size:48px;
}
.hero-copy {
        font-size:13px;
}
.hero-actions {
        align-items:flex-start;
        flex-direction:column;
        gap:17px;
}
.hero-stats {
        width:86%;
        bottom:25px;
        justify-content:space-between;
}
.hero-stats div {
        min-width:0;
}
.category-grid {
        grid-template-columns:1fr 1fr;
        gap:8px;
}
.category-card {
        min-height:240px;
        padding:15px;
}
.category-card h3 {
        font-size:21px;
}
.destination-grid,.destination-grid.large {
        grid-template-columns:1fr;
}
.destination-image {
        height:260px;
}
.about-image {
        height:350px;
}
.quote-section {
        padding:100px 20px;
}
.filter-bar {
        overflow-x:auto;
        flex-wrap:nowrap;
        padding-bottom:5px;
}
.filter-btn {
        white-space:nowrap;
}
.results-head {
        align-items:flex-start;
        gap:15px;
        flex-direction:column;
}
.search-box {
        width:100%;
}
.page-hero {
        min-height:52vh;
}
.footer {
        display:block;
}
.footer>* {
        margin-bottom:16px!important;
}
}
